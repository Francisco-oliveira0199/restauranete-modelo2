datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:SENHA@localhost:5432/lanchonete"
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  pedidos   Pedido[]
}

model Pedido {
  id          Int      @id @default(autoincrement())
  empresa_id  Int
  produto     String
  quantidade  Int
  valor       Float
  endereco    String
  pagamento   String
  createdAt   DateTime @default(now())

  empresa Empresa @relation(fields: [empresa_id], references: [id])
}